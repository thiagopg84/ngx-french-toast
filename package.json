{
  "name": "ngx-french-toast",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "publish": "ng-packagr -p projects/ngx-french-toast/ng-package.json && cd dist/ngx-french-toast && npm publish",
    "test-build": "ng-packagr -p projects/ngx-french-toast/ng-package.json",
    "test-app": "ng s -o --project test-app",
    "standalone-app": "ng s -o --project standalone-app",
    "tarball": "cd dist && tar -cvzf ngx-french-toast.tar.gz ngx-french-toast",
    "commit": "git add . && npx git-cz"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.2.4",
    "@angular/cdk": "^20.2.2",
    "@angular/common": "^20.2.4",
    "@angular/compiler": "^20.2.4",
    "@angular/core": "^20.2.4",
    "@angular/forms": "^20.2.4",
    "@angular/platform-browser": "^20.2.4",
    "@angular/platform-browser-dynamic": "^20.2.4",
    "@angular/router": "^20.2.4",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.2.2",
    "@angular/cli": "^20.2.2",
    "@angular/compiler-cli": "^20.2.4",
    "@types/jasmine": "~4.0.0",
    "jasmine-core": "~4.3.0",
    "jsdom": "^29.1.1",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "ng-packagr": "^20.2.0",
    "prettier": "^3.5.3",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}
